# ShieldHer Environment Variables
# Copy this file to .env.local and fill in your values

# ===========================================
# REQUIRED FOR CORE FUNCTIONALITY
# ===========================================

# JWT Secret - Generate a random 32+ character string
# Example: openssl rand -base64 32
JWT_SECRET=your_jwt_secret_min_32_characters_here

# ===========================================
# AI FEATURES (Required for AI functionality)
# ===========================================

# Google Gemini API Key
# Get from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ===========================================
# MAPS (Required for navigation features)
# ===========================================

# Google Maps JavaScript API Key
# Get from: https://console.cloud.google.com/google/maps-apis
# Enable: Maps JavaScript API, Places API, Directions API
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# ===========================================
# NOTIFICATIONS (Required for SOS alerts)
# ===========================================

# Twilio SMS Service
# Get from: https://www.twilio.com/console
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# Email Service (SMTP)
# For Gmail: Enable 2FA and create App Password
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password

# ===========================================
# OPTIONAL
# ===========================================

# Base URL (auto-detected in most cases)
# NEXT_PUBLIC_BASE_URL=http://localhost:3000
